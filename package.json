{
  "name": "@sandsoftwaresolutions/health",
  "version": "0.1.2",
  "description": "Live and ready health endpoints with timeouts, caching and degraded state, for Docker and load balancers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "health",
    "readiness",
    "liveness",
    "docker"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-health.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-health/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-health#readme",
  "publishConfig": {
    "access": "public"
  }
}
